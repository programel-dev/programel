# ===========================================
# Docker Compose Environment Variables
# Copy to .env and fill in values
# ===========================================

# --- App ---
APP_ENV=dev
APP_SECRET=change_me_to_random_32_chars
COMPOSE_PROJECT_NAME=programel

# --- Database ---
DATABASE_URL=postgresql://programel:programel@postgres:5432/programel?serverVersion=16
POSTGRES_USER=programel
POSTGRES_PASSWORD=programel
POSTGRES_DB=programel

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Symfony Lock (defaults to Redis) ---
LOCK_DSN=redis://redis:6379

# --- JWT ---
JWT_PASSPHRASE=change_me_to_random_passphrase

# --- Sentry (leave empty to disable) ---
SENTRY_DSN=

# --- Mailer ---
# Dev: smtp://mailpit:1025
# Prod: smtp://user:pass@smtp.sendgrid.net:587
MAILER_DSN=smtp://mailpit:1025

# --- Frontend ---
API_INTERNAL_URL=http://api:9000
NEXT_PUBLIC_API_URL=/api/v1

# --- Docker Registry (prod/CI) ---
DOCKER_REGISTRY=ghcr.io/programel
IMAGE_TAG=latest

# --- Server (prod deploy) ---
SERVER_HOST=
SERVER_USER=deploy

# --- e-queue monitor ---
EQUEUE_TARGET_URL=https://munich.pasport.org.ua/solutions/e-queue
EQUEUE_POLL_INTERVAL=300
EQUEUE_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/121.0.0.0 Safari/537.36

# --- Telegram bot (for e-queue notifications) ---
# Create the bot via @BotFather, then run `bin/console app:telegram:set-webhook`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
